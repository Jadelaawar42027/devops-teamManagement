# Copy to terraform.tfvars (git-ignored) only to run Terraform from your own machine.
# The pipeline does not use this file: it sets the same values as TF_VAR_* environment
# variables from GitHub secrets (see README, "Deployment").

resource_group_name = "rg-sdd-3a" # TODO: rg-sdd-3a or rg-sdd-3b, your class
image_tag           = "<commit sha of images already in GHCR>"

# Never put real passwords in a file. Set them in your shell instead:
#   export TF_VAR_sql_admin_password='...'
#   export TF_VAR_kpi_db_password='...'
#   export TF_VAR_routing_db_password='...'
