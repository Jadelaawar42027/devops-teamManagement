index d881561..77311ff 100644
--- a/services/routing/tests/test_migrate.py
+++ b/services/routing/tests/test_migrate.py
@@ -1,3 +1,4 @@
+import shutil
 from contextlib import closing
 
 import pymssql
@@ -77,3 +78,32 @@ def test_failing_migration_is_rolled_back_and_not_recorded(fresh_conn, tmp_path)
     # the first batch of 002 was undone with the rest, so a fixed 002 can run cleanly next start
     assert "half_done" not in table_names(fresh_conn)
     assert "ok_table" in table_names(fresh_conn)
+
+
+def test_002_backfills_contact_name_on_existing_leads(fresh_conn, tmp_path):
+    # boot with 001 only, as Azure did, and store leads the way the old code did
+    shutil.copy(f"{MIGRATIONS_DIR}/001_init.sql", tmp_path)
+    run_migrations(fresh_conn, tmp_path)
+    cur = fresh_conn.cursor()
+    cur.execute("INSERT INTO leads (source, score) OUTPUT INSERTED.id VALUES ('website', 80)")
+    first = cur.fetchone()["id"]
+    cur.execute("INSERT INTO leads (source, score) OUTPUT INSERTED.id VALUES ('phone', 20)")
+    second = cur.fetchone()["id"]
+    cur.execute("INSERT INTO lead_outcomes (lead_id, outcome) VALUES (%s, 'closed')", (first,))
+    fresh_conn.commit()
+
+    # the next deploy brings 002
+    shutil.copy(f"{MIGRATIONS_DIR}/002_add_contact_name.sql", tmp_path)
+    assert run_migrations(fresh_conn, tmp_path) == ["002_add_contact_name.sql"]
+
+    cur.execute("SELECT id, contact_name, source, score FROM leads ORDER BY id")
+    assert cur.fetchall() == [
+        {"id": first, "contact_name": f"Lead #{first}", "source": "website", "score": 80},
+        {"id": second, "contact_name": f"Lead #{second}", "source": "phone", "score": 20},
+    ]
+    cur.execute("SELECT COUNT(*) AS n FROM lead_outcomes WHERE lead_id = %s", (first,))
+    assert cur.fetchone()["n"] == 1
+    # the column is required from now on
+    with pytest.raises(pymssql.IntegrityError):
+        cur.execute("INSERT INTO leads (source, score) VALUES ('website', 50)")
+    fresh_conn.rollback()
